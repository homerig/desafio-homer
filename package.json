{
  "name": "cumpleapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Juegos de cumpleaños en tiempo real",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "admin:create": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node --check server/index.js && node --check server/app.js && node --check server/game.js && node --check public/app.js",
    "test:browser": "node test/browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
